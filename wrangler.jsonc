{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "plotsender",
  "main": "server/main.py",
  "compatibility_flags": ["python_workers"],
  "compatibility_date": "2026-10-17",
  "assets": {
    "directory": "./public",
    "run_worker_first": ["/api/*", "/T/*", "/t/*"]
  },
  // KV: QR のトークンの使用済み記録(qr:...、15分で自動で消える)と、最新の補正データ(correction:...)
  "kv_namespaces": [
    { "binding": "KV", "id": "4477824cf6c04caeb8d6260d6da29095" }
  ]
}
