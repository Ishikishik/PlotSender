{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "plotsender",
  "main": "server/main.py",
  "compatibility_flags": ["python_workers"],
  "compatibility_date": "2026-10-17",
  "assets": {
    "directory": "./public",
    "run_worker_first": ["/api/*", "/T/*", "/t/*"]
  }
  // QR のトークンの使用済み記録(15分で自動で消える)。
  // npx wrangler kv namespace create USED_QR_TOKENS で作り、出てきた id を入れてからコメントを外す
  // ,"kv_namespaces": [
  //   { "binding": "USED_QR_TOKENS", "id": "ここに id" }
  // ]
}
